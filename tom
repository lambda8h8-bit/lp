If you are **already inside your project folder** (e.g., `YourApp`), here is the absolute shortest procedure. You only need to copy and paste these 4 blocks.

### Step 1: Make sure the folder structure exists
```bash
mkdir -p WEB-INF/classes
```

### Step 2: Create all 4 programs at once
Copy and paste this entire block into your terminal:

```bash
# 44: Simple Servlet
cat << 'EOF' > P44.java
import java.io.*;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.*;
@WebServlet("/p44")
public class P44 extends HttpServlet {
    public void doGet(HttpServletRequest q, HttpServletResponse r) throws IOException {
        r.getWriter().print("<h2>Program 44: Simple Servlet Works!</h2>");
    }
}
EOF

# 45: Session Tracking
cat << 'EOF' > P45.java
import java.io.*;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.*;
@WebServlet("/p45")
public class P45 extends HttpServlet {
    public void doGet(HttpServletRequest q, HttpServletResponse r) throws IOException {
        HttpSession s = q.getSession();
        Integer c = (Integer) s.getAttribute("visits");
        c = (c == null) ? 1 : c + 1;
        s.setAttribute("visits", c);
        r.getWriter().print("<h2>Program 45: Visit Count = " + c + "</h2>");
    }
}
EOF

# 47: JDBC Database
cat << 'EOF' > P47.java
import java.io.*;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.*;
import java.sql.*;
@WebServlet("/p47")
public class P47 extends HttpServlet {
    public void doGet(HttpServletRequest q, HttpServletResponse r) throws IOException {
        try (var c = DriverManager.getConnection("jdbc:mysql://localhost/cse1", "root", "root");
             var rs = c.createStatement().executeQuery("SELECT * FROM authors")) {
            while(rs.next()) r.getWriter().print("ID: " + rs.getInt("id") + " Name: " + rs.getString("name") + "<br>");
        } catch(Exception e) { r.getWriter().print("DB Error: " + e.getMessage()); }
    }
}
EOF

# 48: Full Web App
cat << 'EOF' > P48.java
import java.io.*;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.*;
import java.sql.*;
@WebServlet("/p48")
public class P48 extends HttpServlet {
    public void doGet(HttpServletRequest q, HttpServletResponse r) throws IOException {
        HttpSession s = q.getSession();
        Integer c = (Integer) s.getAttribute("hits");
        c = (c == null) ? 1 : c + 1;
        s.setAttribute("hits", c);
        r.getWriter().print("Session Hits: " + c + "<br>");
        try (var conn = DriverManager.getConnection("jdbc:mysql://localhost/cse1", "root", "root");
             var rs = conn.createStatement().executeQuery("SELECT name FROM authors LIMIT 1")) {
            if (rs.next()) r.getWriter().print("DB Author: " + rs.getString("name"));
        } catch (Exception e) { r.getWriter().print("DB Error: " + e.getMessage()); }
    }
}
EOF
```

### Step 3: Compile (using the auto-find trick)
```bash
javac -cp $(find / -name "servlet-api.jar" 2>/dev/null | head -n 1) -d WEB-INF/classes *.java
```

### Step 4: Deploy to Tomcat
*(Skip this step ONLY if you already created this folder directly inside Tomcat's `webapps` folder).*
If your project folder is somewhere else (like your home directory), run this to copy it to Tomcat:
```bash
sudo cp -r . $(find / -type d -name "webapps" 2>/dev/null | head -n 1)/
```

### Step 5: Start Tomcat & Test
Start Tomcat:
```bash
$(find / -name "startup.sh" 2>/dev/null | head -n 1)
```
*(If it's already running, just skip this).*

Now open your browser and test:
*   `http://localhost:8080/YourApp/p44`
*   `http://localhost:8080/YourApp/p45`
*   `http://localhost:8080/YourApp/p47`
*   `http://localhost:8080/YourApp/p48`

*(Note: replace `YourApp` in the URL with whatever your current folder is actually named).*
